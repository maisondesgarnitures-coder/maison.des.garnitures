# Configuration de la boutique en ligne.
# Copie ce fichier en « .env » et remplis les valeurs.
# Ne mets JAMAIS le vrai .env sur un depot public : il contient tes cles.

# « production » des que le site est joignable depuis Internet.
MODE=production

# Cle de signature des sessions. Genere-la UNE fois avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si tu la changes, tout le monde est deconnecte. Ne la partage pas.
SECRET_KEY=

# Base de donnees PostgreSQL fournie par l'hebergeur.
# Laisse vide pour continuer sur le fichier SQLite local.
DATABASE_URL=

# Port d'ecoute. La plupart des hebergeurs l'imposent par cette variable.
PORT=8000

# Nombre de requetes servies en parallele.
THREADS=8

# Cle API First Delivery (sinon renseigne-la dans Admin > Transporteurs).
FIRST_DELIVERY_TOKEN=

# Envoi des e-mails (code de reinitialisation du mot de passe).
# Avec Gmail, le mot de passe du compte ne marche pas : creer un
# « mot de passe d'application » dans Securite > Mots de passe des
# applications, ce qui exige la validation en deux etapes.
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_EXPEDITEUR=Maison des Garnitures <maison.des.garnitures@gmail.com>
